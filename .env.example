# Bundled into the app (public by design). Copy to .env.development.local for local work.
# Production (default when unset): https://hausboss.app — nginx proxies /api, /realtime and /storage.
# Android emulator reaches the host machine at 10.0.2.2; a phone on the same Wi-Fi uses the
# machine's LAN IP (e.g. http://192.168.1.20:3105). iOS simulator can use http://localhost:3105.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3105   # http:// here also enables cleartext traffic in release builds (never for production)
# Socket.IO origin; defaults to EXPO_PUBLIC_API_URL
# EXPO_PUBLIC_REALTIME_URL=
# Native map SDK keys (read by app.config.ts at build time; never commit real keys).
# GOOGLE_MAPS_ANDROID_KEY=
# GOOGLE_MAPS_IOS_KEY=
# Crash / performance monitoring (public DSN, bundled). Empty = Sentry disabled.
# EXPO_PUBLIC_SENTRY_DSN=
# Build-time only (EAS secrets): source-map upload. SENTRY_AUTH_TOKEN must stay out of git.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# EAS project id (from `eas init`); needed for Expo push tokens.
# EAS_PROJECT_ID=
